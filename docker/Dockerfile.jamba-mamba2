# Lightweight Dockerfile that adds Jamba-Mamba2 support to official vLLM image
# This is much faster than building vLLM from scratch

ARG VLLM_VERSION=v0.13.0
FROM vllm/vllm-openai:${VLLM_VERSION} AS base

# Copy the custom Jamba-Mamba2 model implementation
COPY vllm/model_executor/models/jamba_mamba2.py /tmp/jamba_mamba2.py

# Install the custom model and update registry
RUN VLLM_PATH=$(python3 -c "import vllm; print(vllm.__path__[0])") && \
    cp /tmp/jamba_mamba2.py "$VLLM_PATH/model_executor/models/jamba_mamba2.py" && \
    REGISTRY_PATH="$VLLM_PATH/model_executor/models/registry.py" && \
    if ! grep -q "JambaMamba2ForCausalLM" "$REGISTRY_PATH"; then \
        sed -i 's/"JambaForCausalLM": ("jamba", "JambaForCausalLM"),/"JambaForCausalLM": ("jamba", "JambaForCausalLM"),\n    "JambaMamba2ForCausalLM": ("jamba_mamba2", "JambaMamba2ForCausalLM"),/' "$REGISTRY_PATH" && \
        echo "Registry updated successfully"; \
    else \
        echo "Registry already contains JambaMamba2ForCausalLM"; \
    fi

# Verify core vLLM mamba2 dependencies exist
RUN python3 -c "from vllm.model_executor.layers.mamba.mamba_mixer2 import MambaMixer2; print('MambaMixer2 found')" && \
    python3 -c "from vllm.model_executor.layers.mamba.mamba2_metadata import Mamba2Metadata; print('Mamba2Metadata found')" && \
    python3 -c "from vllm.model_executor.models.jamba_mamba2 import JambaMamba2ForCausalLM; print('JambaMamba2ForCausalLM imported successfully')"

ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
